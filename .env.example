# Purpose: document the environment boundary. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/universal_api
REDIS_URL=redis://localhost:6379
# Optional Phase 3 provider configuration. Without all three values, the application uses deterministic fallbacks.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
# Optional self-hosted Crawl4AI sidecar. Website discovery is unavailable until its base URL is configured.
CRAWL4AI_BASE_URL=
CRAWL4AI_TOKEN=
